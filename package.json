{
  "name": "vela",
  "version": "0.1.0",
  "private": true,
  "description": "A native desktop cockpit for coding agents",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "postinstall": "node scripts/configure-node-pty.mjs",
    "dev": "node scripts/launch.mjs dev",
    "build": "npm run build:compile && npm start",
    "build:compile": "electron-vite build",
    "start": "node scripts/launch.mjs preview",
    "pack": "node scripts/install-app.mjs --pack-only",
    "install-app": "node scripts/install-app.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:platform": "vitest run scripts/launch.test.ts src/main/terminal.test.ts && node scripts/pty-smoke.mjs && node scripts/electron-pty-smoke.mjs && node scripts/electron-trust-smoke.mjs && node scripts/workspace-observation-smoke.mjs && node scripts/electron-browser-smoke.mjs && node scripts/electron-devtools-smoke.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "architecture:check": "node scripts/check-architecture.mjs",
    "architecture:ratchet": "node scripts/check-architecture.mjs --ratchet",
    "architecture:measure": "node scripts/architecture-analysis.mjs",
    "generate-icons": "node scripts/generate-icons.mjs",
    "client:drift": "node scripts/check-client-drift.mjs",
    "smoke:opencode": "node scripts/opencode-v2-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run docs:check && npm run architecture:check && npm run build:compile",
    "test:sass-worker": "node scripts/sass-worker-smoke.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@opencode/client": "2.0.16",
    "@pierre/diffs": "1.2.10",
    "@shikijs/stream": "4.2.0",
    "@vscode/codicons": "^0.0.46-24",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "5.0.0",
    "diff": "8.0.2",
    "dompurify": "3.3.1",
    "electron-updater": "6.8.10",
    "emmet-monaco-es": "^5.7.0",
    "json5": "2.2.3",
    "katex": "0.16.27",
    "marked": "^18.0.7",
    "marked-shiki": "1.2.1",
    "monaco-editor": "^0.53.0",
    "morphdom": "2.7.8",
    "motion": "12.34.5",
    "node-pty": "^1.1.0",
    "postcss": "^8.5.26",
    "postcss-value-parser": "^4.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remend": "^1.3.0",
    "sass": "1.102.0",
    "shiki": "4.2.0",
    "source-map-js": "^1.2.1",
    "strip-ansi": "7.1.2"
  },
  "devDependencies": {
    "@types/katex": "0.16.7",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.7"
  }
}
